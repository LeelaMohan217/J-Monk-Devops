# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build archives. The `dist` rule above matches only a file or directory named
# exactly "dist", so a committed dist.zip slipped past it three times and left
# ~129MB of dead blobs in history before a purge removed them.
*.zip
*.tar
*.tar.gz
*.7z

# Image masters. Photos ship as a committed .webp + .jpg pair encoded down from
# these; the sources are 20x to 50x larger and nothing imports them, so they
# stay local. Keep your originals somewhere outside the repo as well, since
# git is not backing them up.
src/**/assets/**/*.png
# The logo and the shared mark are genuine PNG deliverables, not masters.
!src/shared/assets/*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
